{
  "name": "agent-core",
  "version": "0.1.0",
  "description": "Generic conversational agent core: durable inbox / outbox in SQLite, append-only events, connectors, no polling.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@slack/bolt": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
